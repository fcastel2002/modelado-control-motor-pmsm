<?xml version="1.0" encoding="utf-8"?>
<chart id="26">
  <P Name="name">Modelo Global /MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">26</P>
  <P Name="ssIdHighWaterMark">12</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">-1</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">phase_unwrap</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">26</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [theta_ev,vueltas_nuevas]  = phase_unwrap(theta,theta_prev,vueltas_actuales)

delta_theta = theta-theta_prev;

if delta_theta &gt; pi
    vueltas_nuevas = vueltas_actuales - 1;
elseif delta_theta &lt; -pi
    vueltas_nuevas = vueltas_actuales + 1;
else
    vueltas_nuevas = vueltas_actuales;
end
theta_ev = theta + 2*pi*vueltas_nuevas;
end</P>
      </eml>
    </state>
    <data SSID="5" name="theta_ev">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
