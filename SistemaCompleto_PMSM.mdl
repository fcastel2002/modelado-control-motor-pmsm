              <period>0.0</period>
            </rateSpec>
            <sti>1</sti>
          </rates>
          <rates type="sltp.mm.core.Rate" uuid="6c00877b-25a3-4a95-9826-e1ef012a5157">
            <annotation>D1</annotation>
