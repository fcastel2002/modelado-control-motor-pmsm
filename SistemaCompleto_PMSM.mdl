<?xml version="1.0" encoding="utf-8"?>
<chart id="29">
  <P Name="name">Modelo Global NL
Controlador modulador de torque6/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">29</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">10</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">1e-4</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">GeneradorTrayectoria</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">29</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [theta_ref,omega_ref,accel_ref]= GeneradorTrayectoria(t,consigna_posicion, t_rampa_vel, t_rampa_acel)
persistent inicializado
persistent dt_vec dq_vec
persistent h1_vec h2_vec
persistent tr1_vec tr2_vec
persistent t_nodos q_nodos N

if isempty(inicializado)
    N = 0;
    for i = 1:size(consigna_posicion,1)
        if ~isnan(consigna_posicion(i,1)) &amp;&amp; ~isnan(consigna_posicion(i,2))
            N = N + 1;
        else
            break;
        end
    end

    if N &lt; 2
        error(&apos;Debe haber al menos 2 puntos válidos en Matriz_Consigna&apos;);
    end
    t_nodos = consigna_posicion(1:N,1);
    q_nodos = consigna_posicion(1:N,2);
    n_tramos = N-1;
    dt_vec = zeros(n_tramos,1);
    dq_vec = zeros(n_tramos,1);
    h1_vec = zeros(n_tramos,1);
    h2_vec = zeros(n_tramos,1);
    tr1_vec = zeros(n_tramos,1);
    tr2_vec = zeros(n_tramos,1);
    for k = 1:n_tramos
        dt_vec(k) = t_nodos(k+1)-t_nodos(k);
        dq_vec(k) = q_nodos(k+1)-q_nodos(k);

        tr1_vec(k)=t_rampa_vel;
        tr2_vec(k)=t_rampa_acel;

        if tr1_vec(k) &lt;= 0
            error(&apos;t_rampa_vel debe ser &gt; 0 en el tramo %d.&apos;,k);
        end

        if tr2_vec(k) &lt;= 0 || tr2_vec(k) &gt;= tr1_vec(k)
            error(&apos;Debe cumplirse 0 &lt; t_rampa_acel &lt; t_rampa_vel en el tramo %d.&apos;,k);
        end

        if dt_vec(k) &lt; 2*tr1_vec(k)
            error(&apos;Debe cumplirse dt &gt;= 2*t_rampa_vel en el tramo %d.&apos;,k);
        end
        %Altura velocidad
        h1_vec(k) = abs(dq_vec(k))/(dt_vec(k)-tr1_vec(k));
        h2_vec(k) = h1_vec(k)/(tr1_vec(k)-tr2_vec(k));
    end
    inicializado=true;
end

if t &lt;= t_nodos(1)
    theta_ref = q_nodos(1);
    omega_ref = 0;
    accel_ref = 0;
    return;
end

if t&gt;= t_nodos(end)
    theta_ref = q_nodos(end);
    omega_ref = 0;
    accel_ref = 0;
    return;
end

tramo_actual = 1;
for k = 1:(N-1)
    if t &gt;= t_nodos(k) &amp;&amp; t &lt; t_nodos(k+1)
        tramo_actual = k;
        break;
    end
end
tau = t - t_nodos(tramo_actual);

q0  = q_nodos(tramo_actual);
dt  = dt_vec(tramo_actual);
dq  = dq_vec(tramo_actual);
h1  = h1_vec(tramo_actual);
h2  = h2_vec(tramo_actual);
tr1 = tr1_vec(tramo_actual);
tr2 = tr2_vec(tramo_actual);
sgn = sign(dq);
dq_abs = abs(dq);
if dq_abs &lt; 1e-12
    theta_ref = q0;
    omega_ref = 0;
    accel_ref = 0;
    return;
end

% if tau &lt; tr1
%     % Aceleración
%     omega_ref = h1 * (tau / tr1);
%     theta_ref = q0 + 0.5 * (h1/tr1) * tau^2;
% elseif tau &lt; (dt - tr1)
%     % Velocidad constante
%     omega_ref = h1;
%     theta_ref = q0 ...
%         + 0.5*h1*tr1 ...
%         + h1*(tau - tr1);
%
% elseif tau &lt;= dt
%     % Desaceleración
%     td = tau - (dt - tr1);
%     omega_ref = h1 * (1 - td/tr1);
%     theta_ref = q_nodos(tramo_actual+1) ...
%         - 0.5 * (h1/tr1) * (dt - tau)^2;
% else
%     theta_ref = q_nodos(tramo_actual+1);
%     omega_ref = 0;
% end

[theta_ref, omega_ref, accel_ref] = perfil_7_subtramos( ...
    tau, q0, q_nodos(tramo_actual+1), dt, h1, h2, tr1, tr2, sgn);
end

function [theta_ref, omega_ref, accel_ref] = perfil_7_subtramos(tau, q0, qf, dt, h1, h2, tr1, tr2, sgn)

    d_acc = 0.5*h1*tr1;

    if tau &lt;= 0
        theta_ref = q0;
        omega_ref = 0;
        accel_ref = 0;

    elseif tau &lt; tr1
        [s_local, w_local, a_local] = perfil_arranque_local(tau, h2, tr1, tr2);
        theta_ref = q0 + sgn*s_local;
        omega_ref = sgn*w_local;
        accel_ref = sgn*a_local;

    elseif tau &lt; (dt - tr1)
        u = tau - tr1;
        theta_ref = q0 + sgn*(d_acc + h1*u);
        omega_ref = sgn*h1;
        accel_ref = 0;

    elseif tau &lt;= dt
        rho = dt - tau;
        [s_local, w_local, a_local] = perfil_arranque_local(rho, h2, tr1, tr2);
        theta_ref = qf - sgn*s_local;
        omega_ref = sgn*w_local;
        accel_ref = -sgn*a_local;

    else
        theta_ref = qf;
        omega_ref = 0;
        accel_ref = 0;
    end
end
function [s_local, w_local, a_local] = perfil_arranque_local(tloc, h2, tr1, tr2)

    t1 = tr2;
    t2 = tr1 - tr2;

    if tloc &lt;= 0
        s_local = 0;
        w_local = 0;
        a_local = 0;

    elseif tloc &lt; t1
        % Subtramo 1: aceleración sube linealmente
        a_local = (h2/tr2)*tloc;
        w_local = (h2/(2*tr2))*tloc^2;
        s_local = (h2/(6*tr2))*tloc^3;

    elseif tloc &lt; t2
        % Subtramo 2: aceleración constante = h2
        u = tloc - tr2;

        w1 = h2*tr2/2;
        s1 = h2*tr2^2/6;

        a_local = h2;
        w_local = w1 + h2*u;
        s_local = s1 + w1*u + 0.5*h2*u^2;

    elseif tloc &lt;= tr1
        % Subtramo 3: aceleración baja linealmente hasta 0
        u = tloc - (tr1 - tr2);

        w2 = h2*tr2/2 + h2*(tr1 - 2*tr2);
        s2 = h2*tr2^2/6 ...
           + (h2*tr2/2)*(tr1 - 2*tr2) ...
           + 0.5*h2*(tr1 - 2*tr2)^2;

        a_local = h2 - (h2/tr2)*u;
        w_local = w2 + h2*u - (h2/(2*tr2))*u^2;
        s_local = s2 + w2*u + 0.5*h2*u^2 - (h2/(6*tr2))*u^3;

    else
        a_local = 0;
        w_local = h2*(tr1 - tr2);   % = h1
        s_local = 0.5*w_local*tr1;
    end
end</P>
      </eml>
    </state>
